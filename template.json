{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Torn Redeye YATA Japan Xanax collector; deploy only in eu-north-1",
  "Parameters": {
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ],
      "Description": "Keep disabled until manual collection and persistence are verified"
    },
    "OperatorEmail": {
      "Type": "String",
      "Default": "",
      "NoEcho": true,
      "AllowedPattern": "^$|^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "Description": "Optional private operator email; confirm the SNS subscription before enabling production alerts"
    }
  },
  "Rules": {
    "StockholmOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-north-1"
            ]
          },
          "AssertDescription": "This work package is approved only for eu-north-1"
        }
      ]
    }
  },
  "Resources": {
    "EvidenceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "CollectorLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/tornredeye/${AWS::StackName}/collector"
        },
        "RetentionInDays": 14
      }
    },
    "CollectorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CollectorEvidenceAndLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ConditionalEvidenceWrites",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${EvidenceBucket.Arn}/raw/yata/jap/206/*"
                    },
                    {
                      "Fn::Sub": "${EvidenceBucket.Arn}/normalized/yata/jap/206/*"
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "s3:if-none-match": "*"
                    }
                  }
                },
                {
                  "Sid": "CompareExistingEvidence",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${EvidenceBucket.Arn}/raw/yata/jap/206/*"
                    },
                    {
                      "Fn::Sub": "${EvidenceBucket.Arn}/normalized/yata/jap/206/*"
                    }
                  ]
                },
                {
                  "Sid": "WriteCollectorLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${CollectorLogGroup}:log-stream:*"
                  }
                },
                {
                  "Sid": "ReadPollingControl",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/control/yata/jap/206/polling.json"
                  }
                },
                {
                  "Sid": "UpdatePollingControl",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${EvidenceBucket.Arn}/control/yata/jap/206/polling.json"
                  },
                  "Condition": {
                    "Null": {
                      "s3:if-match": "false"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CollectorFunction": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "CodeUri": ".aws-sam/collector.zip",
        "Handler": "lambda_function.lambda_handler",
        "Runtime": "python3.13",
        "Architectures": [
          "x86_64"
        ],
        "MemorySize": 128,
        "Timeout": 120,
        "Role": {
          "Fn::GetAtt": [
            "CollectorRole",
            "Arn"
          ]
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "CollectorLogGroup"
          }
        },
        "Environment": {
          "Variables": {
            "DESTINATION_BUCKET": {
              "Ref": "EvidenceBucket"
            },
            "YATA_TIMEOUT_SECONDS": "15"
          }
        }
      }
    },
    "CollectorAsyncConfiguration": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "CollectorFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumEventAgeInSeconds": 60,
        "MaximumRetryAttempts": 0
      }
    },
    "CollectionScheduleGroup": {
      "Type": "AWS::Scheduler::ScheduleGroup"
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  },
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "CollectionScheduleGroup",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeCollectorOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CollectorFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CollectionSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "DependsOn": [
        "CollectorAsyncConfiguration"
      ],
      "Properties": {
        "GroupName": {
          "Ref": "CollectionScheduleGroup"
        },
        "ScheduleExpression": "rate(1 minute)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": {
          "Ref": "ScheduleState"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "CollectorFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": "{}",
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 60,
            "MaximumRetryAttempts": 1
          }
        }
      }
    },
    "MonitoringTopic": {
      "Type": "AWS::SNS::Topic"
    },
    "OperatorSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasOperatorEmail",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "OperatorEmail"
        },
        "TopicArn": {
          "Ref": "MonitoringTopic"
        }
      }
    },
    "PersistedObservationFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "CollectorLogGroup"
        },
        "FilterPattern": "\"persisted\" \"status=observed\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "TornRedeye/${AWS::StackName}"
            },
            "MetricName": "PersistedObservations",
            "MetricValue": "1",
            "DefaultValue": 0,
            "Unit": "Count"
          }
        ]
      }
    },
    "PollingHaltFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "CollectorLogGroup"
        },
        "FilterPattern": "\"collection skipped\" \"reason=halted:\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "TornRedeye/${AWS::StackName}"
            },
            "MetricName": "PollingHalts",
            "MetricValue": "1",
            "DefaultValue": 0,
            "Unit": "Count"
          }
        ]
      }
    },
    "MissingObservationsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": [
        "PersistedObservationFilter",
        "MonitoringTopicPolicy"
      ],
      "Properties": {
        "ActionsEnabled": {
          "Fn::If": [
            "MonitoringActionsEnabled",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "ComparisonOperator": "LessThanThreshold",
        "Threshold": 1,
        "EvaluationPeriods": 15,
        "DatapointsToAlarm": 15,
        "TreatMissingData": "breaching",
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-missing-observations"
        },
        "AlarmDescription": "No successfully persisted observed result in approximately 15 minutes. Check logs, S3 evidence, schedule and guard; HTTP success and persisted missing/error results do not count.",
        "Metrics": [
          {
            "Id": "observations",
            "ReturnData": false,
            "MetricStat": {
              "Metric": {
                "Namespace": {
                  "Fn::Sub": "TornRedeye/${AWS::StackName}"
                },
                "MetricName": "PersistedObservations"
              },
              "Period": 60,
              "Stat": "Sum"
            }
          },
          {
            "Id": "heartbeat",
            "Expression": "FILL(observations, 0)",
            "ReturnData": true
          }
        ]
      }
    },
    "CollectionErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ActionsEnabled": {
          "Fn::If": [
            "MonitoringActionsEnabled",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 1,
        "EvaluationPeriods": 5,
        "DatapointsToAlarm": 3,
        "TreatMissingData": "notBreaching",
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-collection-errors"
        },
        "AlarmDescription": "Lambda errors in at least 3 of 5 one-minute periods, including collection, configuration, control, persistence or runtime timeout. OK means the error threshold no longer breaches, not proof of observation recovery.",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "CollectorFunction"
            }
          }
        ],
        "Period": 60,
        "Statistic": "Sum"
      },
      "DependsOn": [
        "MonitoringTopicPolicy"
      ]
    },
    "PollingHaltAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "DependsOn": [
        "PollingHaltFilter",
        "MonitoringTopicPolicy"
      ],
      "Properties": {
        "ActionsEnabled": {
          "Fn::If": [
            "MonitoringActionsEnabled",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 1,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "TreatMissingData": "notBreaching",
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-polling-halted"
        },
        "AlarmDescription": "Guard returned halted; inspect restrictions or stale attempt before operator recovery. OK means no recent halt log; use observation heartbeat to confirm recovery.",
        "Namespace": {
          "Fn::Sub": "TornRedeye/${AWS::StackName}"
        },
        "MetricName": "PollingHalts",
        "Period": 60,
        "Statistic": "Sum"
      }
    },
    "MonitoringTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "MonitoringTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "MonitoringTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-missing-observations"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-collection-errors"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-polling-halted"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "EvidenceBucketName": {
      "Value": {
        "Ref": "EvidenceBucket"
      }
    },
    "CollectorFunctionName": {
      "Value": {
        "Ref": "CollectorFunction"
      }
    },
    "CollectorLogGroupName": {
      "Value": {
        "Ref": "CollectorLogGroup"
      }
    },
    "CollectionScheduleName": {
      "Value": {
        "Ref": "CollectionSchedule"
      }
    },
    "CollectionScheduleGroupName": {
      "Value": {
        "Ref": "CollectionScheduleGroup"
      }
    },
    "MonitoringTopicArn": {
      "Value": {
        "Ref": "MonitoringTopic"
      }
    },
    "MonitoringMetricNamespace": {
      "Value": {
        "Fn::Sub": "TornRedeye/${AWS::StackName}"
      }
    }
  },
  "Conditions": {
    "HasOperatorEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "OperatorEmail"
            },
            ""
          ]
        }
      ]
    },
    "MonitoringActionsEnabled": {
      "Fn::Equals": [
        {
          "Ref": "ScheduleState"
        },
        "ENABLED"
      ]
    }
  }
}
