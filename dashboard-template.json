{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Independent public operations dashboard; no collector mutations",
  "Parameters": {
    "EvidenceBucketName": {
      "Type": "String",
      "MinLength": 1
    },
    "CollectorFunctionName": {
      "Type": "String",
      "MinLength": 1
    },
    "CollectorLogGroupName": {
      "Type": "String",
      "MinLength": 1
    },
    "MonitoringMetricNamespace": {
      "Type": "String",
      "MinLength": 1
    },
    "MonitoringTopicName": {
      "Type": "String",
      "MinLength": 1
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ]
    },
    "FreePlanCandidate": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ],
      "Description": "Review gated candidate; origin error security headers are NOT equivalent. No subscription is created."
    },
    "DistributionEnabled": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Keep false throughout protection activation and rollback until verified."
    },
    "WebAclArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:wafv2:us-east-1:[0-9]{12}:global/webacl/[A-Za-z0-9_-]+/[a-f0-9-]+$",
      "Description": "Dedicated CLOUDFRONT ACL ARN; association remains owned by this stack."
    }
  },
  "Rules": {
    "StockholmOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-north-1"
            ]
          },
          "AssertDescription": "Deploy regional dashboard components in Stockholm"
        }
      ]
    },
    "CandidateRequiresWebAcl": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "FreePlanCandidate"
          },
          "ENABLED"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "WebAclArn"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Candidate requires a dedicated CLOUDFRONT ACL before subscription."
        }
      ]
    }
  },
  "Resources": {
    "DashboardBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-public-cache"
          },
          "DefaultTTL": 300,
          "MinTTL": 0,
          "MaxTTL": 3600,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "SecurityHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-security"
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
              "Override": true
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": {
            "Fn::If": [
              "DeliveryEnabled",
              true,
              false
            ]
          },
          "DefaultRootObject": "index.html",
          "PriceClass": {
            "Fn::If": [
              "UseFreePlanCandidate",
              "PriceClass_All",
              "PriceClass_100"
            ]
          },
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "private-s3",
              "DomainName": {
                "Fn::GetAtt": [
                  "DashboardBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginPath": "/public",
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-s3",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Fn::If": [
                "UseFreePlanCandidate",
                "658327ea-f89d-4fab-a63d-7e88639e58f6",
                {
                  "Ref": "CachePolicy"
                }
              ]
            },
            "ResponseHeadersPolicyId": {
              "Fn::If": [
                "UseFreePlanCandidate",
                "67f7725c-6f97-4210-82d7-5512b31e9d03",
                {
                  "Ref": "SecurityHeaders"
                }
              ]
            },
            "FunctionAssociations": {
              "Fn::If": [
                "UseFreePlanCandidate",
                [
                  {
                    "EventType": "viewer-response",
                    "FunctionARN": {
                      "Fn::GetAtt": [
                        "ViewerSecurityHeaders",
                        "FunctionARN"
                      ]
                    }
                  }
                ],
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          },
          "WebACLId": {
            "Fn::If": [
              "HasWebAcl",
              {
                "Ref": "WebAclArn"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        }
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DashboardBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${DashboardBucket.Arn}/public/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DashboardBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DashboardBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "PublisherLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/tornredeye/${AWS::StackName}/publisher"
        },
        "RetentionInDays": 7
      }
    },
    "PublisherRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BoundedDashboardPublication",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:GetMetricStatistics"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:FilterLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${CollectorLogGroupName}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${EvidenceBucketName}/evidence/live-v1/*/attempt.json"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DashboardBucket.Arn}/public/data.json"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DashboardBucket.Arn}/public/data.json"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:if-none-match": "*"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DashboardBucket.Arn}/public/data.json"
                  },
                  "Condition": {
                    "Null": {
                      "s3:if-match": "false"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${PublisherLogGroup}:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Publisher": {
      "Type": "AWS::Serverless::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-publisher"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "x86_64"
        ],
        "MemorySize": 128,
        "Timeout": 90,
        "Handler": "dashboard_publisher.lambda_handler",
        "CodeUri": ".aws-sam/dashboard-publisher.zip",
        "Role": {
          "Fn::GetAtt": [
            "PublisherRole",
            "Arn"
          ]
        },
        "Environment": {
          "Variables": {
            "EVIDENCE_BUCKET": {
              "Ref": "EvidenceBucketName"
            },
            "COLLECTOR_FUNCTION": {
              "Ref": "CollectorFunctionName"
            },
            "COLLECTOR_LOG_GROUP": {
              "Ref": "CollectorLogGroupName"
            },
            "MONITORING_NAMESPACE": {
              "Ref": "MonitoringMetricNamespace"
            },
            "MONITORING_TOPIC_NAME": {
              "Ref": "MonitoringTopicName"
            },
            "DASHBOARD_BUCKET": {
              "Ref": "DashboardBucket"
            },
            "PUBLISHER_FUNCTION": {
              "Fn::Sub": "${AWS::StackName}-publisher"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "PublisherLogGroup"
          }
        }
      }
    },
    "AsyncConfiguration": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "Publisher"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60
      }
    },
    "HourlyPublication": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(1 hour)",
        "State": {
          "Ref": "ScheduleState"
        },
        "Targets": [
          {
            "Id": "publisher",
            "Arn": {
              "Fn::GetAtt": [
                "Publisher",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 0,
              "MaximumEventAgeInSeconds": 60
            }
          }
        ],
        "Name": {
          "Fn::Sub": "${AWS::StackName}-hourly"
        }
      },
      "DependsOn": [
        "AsyncConfiguration",
        "SchedulePermission"
      ]
    },
    "SchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Publisher"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/${AWS::StackName}-hourly"
        }
      }
    },
    "ViewerSecurityHeaders": {
      "Type": "AWS::CloudFront::Function",
      "Condition": "UseFreePlanCandidate",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-viewer-security"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Successful responses only; origin >=400 bypasses viewer response functions",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n    var response = event.response;\n    var headers = response.headers;\n    headers['content-security-policy'] = { value: \"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'\" };\n    headers['x-frame-options'] = { value: 'DENY' };\n    headers['referrer-policy'] = { value: 'no-referrer' };\n    headers['strict-transport-security'] = { value: 'max-age=31536000' };\n    headers['x-content-type-options'] = { value: 'nosniff' };\n    delete headers['x-xss-protection'];\n    return response;\n}\n"
      }
    }
  },
  "Outputs": {
    "DashboardBucketName": {
      "Value": {
        "Ref": "DashboardBucket"
      }
    },
    "DashboardUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}/"
      }
    },
    "PublisherFunctionName": {
      "Value": {
        "Ref": "Publisher"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
      }
    }
  },
  "Conditions": {
    "UseFreePlanCandidate": {
      "Fn::Equals": [
        {
          "Ref": "FreePlanCandidate"
        },
        "ENABLED"
      ]
    },
    "HasWebAcl": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "WebAclArn"
            },
            ""
          ]
        }
      ]
    },
    "DeliveryEnabled": {
      "Fn::Equals": [
        {
          "Ref": "DistributionEnabled"
        },
        "true"
      ]
    }
  }
}
